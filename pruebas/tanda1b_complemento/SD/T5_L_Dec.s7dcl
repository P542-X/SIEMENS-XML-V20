FUNCTION "T5_L_Dec" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_42002_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            Dec{
                DestType := Int; 
                DisableENO := TRUE
            }( "T5_Datos".Dec_Var )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
