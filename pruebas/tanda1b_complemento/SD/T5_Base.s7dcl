FUNCTION "T5_Base" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_42000_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "T5_Datos".Tog )
            Not()
            Coil( "T5_Datos".Tog )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_42000_2"
    }
    NETWORK
