FUNCTION "T5_L_DECO" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_42007_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            DECO{
                value_type := UInt; 
                return_type := DWord; 
                DisableENO := TRUE
            }(
                IN := "T5_Datos".UInt_3, 
                OUT => "T5_Datos".DECO_Out
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_42007_2"
    }
    NETWORK
        RUNG wire#powerrail
            Eq{ SrcType := DWord }(
                IN1 := "T5_Datos".DECO_Out, 
                IN2 := 16#00000008
            )
            Coil( "T5_Resultado".L_DECO )
        END_RUNG

    END_NETWORK

