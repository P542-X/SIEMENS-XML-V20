{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
    S7_Author := "IA";
    S7_BlockNumber := "43004";
    S7_BlockTitle := "MLC_43004_0"
}
FUNCTION "T6_L_T_SUB" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_43004_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            T_SUB{
                date_type := DTL; 
                time_type := Time
            }(
                IN1 := "T6_Datos".Dtl_1, 
                IN2 := "T6_Datos".T_1h, 
                OUT => "T6_Datos".Dtl_3
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_43004_2"
    }
    NETWORK
        RUNG wire#powerrail
            Eq{ SrcType := USInt }(
                IN1 := "T6_Datos".Dtl_3.HOUR, 
                IN2 := 9
            )
            Coil( "T6_Resultado".L_T_SUB )
        END_RUNG

    END_NETWORK

END_FUNCTION
