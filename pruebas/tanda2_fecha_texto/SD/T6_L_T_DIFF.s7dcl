FUNCTION "T6_L_T_DIFF" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_43005_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            T_DIFF{
                date_type := DTL; 
                time_type := Time
            }(
                IN1 := "T6_Datos".Dtl_2, 
                IN2 := "T6_Datos".Dtl_1, 
                OUT => "T6_Datos".T_Diff
