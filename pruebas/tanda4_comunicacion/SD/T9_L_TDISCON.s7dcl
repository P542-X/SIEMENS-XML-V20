FUNCTION "T9_L_TDISCON" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        id : CONN_OUC;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46004_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_TDISCON_DB".TDISCON{ id_type := CONN_OUC }(
                REQ := #req, 
                ID := #id, 
                DONE => #done, 
                BUSY => #busy, 
                ERROR => #err, 
                STATUS => #st
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
