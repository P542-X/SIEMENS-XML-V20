FUNCTION "T9_L_MB_CLIENT" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        {
             InstructionName := "TCON_IP_v4";
             LibVersion := "1.0"
        }
        con : TCON_IP_v4;
        regs : Array[0..9] of Word;
        mode : USInt;
        addr : UDInt;
        mlen : UInt;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46015_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_MB_CLIENT_DB".MB_CLIENT(
                REQ := #req, 
                DISCONNECT := #req, 
                MB_MODE := #mode, 
                MB_DATA_ADDR := #addr, 
                MB_DATA_LEN := #mlen, 
                RD_MB_DATA_ADDR :=  , 
                RD_MB_DATA_LEN :=  , 
                WR_MB_DATA_ADDR :=  , 
                WR_MB_DATA_LEN :=  , 
                DONE => #done, 
                BUSY => #busy, 
                ERROR => #err, 
                STATUS => #st, 
                MB_DATA_PTR := #regs, 
                CONNECT := #con, 
                RD_MB_DATA_PTR :=  , 
                WR_MB_DATA_PTR :=  
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
