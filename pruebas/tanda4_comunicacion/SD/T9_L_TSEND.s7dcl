{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
    S7_Author := "IA";
    S7_BlockNumber := "46005";
    S7_BlockTitle := "MLC_46005_0"
}
FUNCTION "T9_L_TSEND" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        id : CONN_OUC;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46005_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_TSEND_DB".TSEND{
                data_type := Variant; 
                len_type := UDInt; 
                id_type := CONN_OUC
            }(
                REQ := #req, 
                ID := #id, 
                LEN := #len, 
                DONE => #done, 
                BUSY => #busy, 
                ERROR => #err, 
                STATUS => #st, 
                DATA := #data
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
