{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
    S7_Author := "IA";
    S7_BlockNumber := "46008";
    S7_BlockTitle := "MLC_46008_0"
}
FUNCTION "T9_L_TURCV" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        id : CONN_OUC;
        rlen : UDInt;
        {
             InstructionName := "TADDR_Param";
             LibVersion := "1.0"
        }
        dir : TADDR_Param;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46008_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_TURCV_DB".TURCV{
                ptr_type := Variant; 
                value_type := UDInt; 
                id_type := CONN_OUC; 
                addr_type := Variant
            }(
                EN_R := #req, 
                ID := #id, 
                LEN := #len, 
                NDR => #done, 
                BUSY => #busy, 
                ERROR => #err, 
                STATUS => #st, 
                RCVD_LEN => #rlen, 
                DATA := #data, 
                ADDR := #dir
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
