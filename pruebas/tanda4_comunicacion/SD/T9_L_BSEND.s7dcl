FUNCTION "T9_L_BSEND" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        id : CONN_PRG;
        rid : CONN_R_ID;
        wlen : Word;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46011_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_BSEND_DB".BSEND{
                ptr_type := Variant; 
                id_type := CONN_PRG; 
                r_id_type := CONN_R_ID
            }(
                REQ := #req, 
                R := #req, 
                ID := #id, 
                R_ID := #rid, 
                DONE => #done, 
                ERROR => #err, 
                STATUS => #st, 
                SD_1 := #data, 
                LEN := #wlen
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
