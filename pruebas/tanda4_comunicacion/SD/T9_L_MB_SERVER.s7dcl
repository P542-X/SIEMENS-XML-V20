{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
    S7_Author := "IA";
    S7_BlockNumber := "46016";
    S7_BlockTitle := "MLC_46016_0"
}
FUNCTION "T9_L_MB_SERVER" : Void
    VAR_TEMP 
        req : Bool;
        done : Bool;
        busy : Bool;
        err : Bool;
        st : Word;
        data : Array[0..99] of Byte;
        len : UDInt;
        {
             InstructionName := "TCON_IP_v4";
             LibVersion := "1.0"
        }
        con : TCON_IP_v4;
        regs : Array[0..9] of Word;
        mode : USInt;
        addr : UDInt;
        mlen : UInt;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_46016_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            "T9_MB_SERVER_DB".MB_SERVER(
                DISCONNECT := #req, 
                NDR => #done, 
                DR => #busy, 
                ERROR => #err, 
                STATUS => #st, 
                MB_HOLD_REG := #regs, 
                CONNECT := #con
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
