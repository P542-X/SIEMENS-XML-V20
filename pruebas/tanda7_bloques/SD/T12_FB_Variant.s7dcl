FUNCTION_BLOCK "T12_FB_Variant"
    VAR_INPUT 
        entrada : Variant;
    END_VAR
    VAR_OUTPUT 
        Salida : Int;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_48011_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            VariantGet{
                src_type := Variant; 
                dst_type := Variant
            }(
                SRC := #entrada, 
                DST => #Salida
            )
        END_RUNG

    END_NETWORK

END_FUNCTION_BLOCK
