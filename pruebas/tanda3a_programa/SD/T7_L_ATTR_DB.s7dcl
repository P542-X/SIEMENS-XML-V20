FUNCTION "T7_L_ATTR_DB" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44013_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            ATTR_DB(
                REQ := True, 
                DB_NUMBER := "T7_Std", 
                RET_VAL => "T7_Datos".Ret_Attr, 
                DB_LENGTH => "T7_Datos".DB_Longitud, 
                ATTRIB => "T7_Datos".DB_Atributos
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44013_2"
    }
    NETWORK
        RUNG wire#powerrail
            Eq{ SrcType := Int }(
                IN1 := "T7_Datos".Ret_Attr, 
                IN2 := 0
            )
            Gt{ SrcType := UDInt }(
                IN1 := "T7_Datos".DB_Longitud, 
                IN2 := 0
            )
            Coil( "T7_Resultado".L_ATTR_DB )
        END_RUNG

