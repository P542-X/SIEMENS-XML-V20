FUNCTION "T7_L_AIRT" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44014_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            DIS_AIRT(RET_VAL => "T7_Datos".Ret_DIS_AIRT)
            EN_AIRT(RET_VAL => "T7_Datos".Ret_EN_AIRT)
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44014_2"
    }
