FUNCTION_BLOCK "T7_L_Alarm"
    VAR 
        {
             InstructionName := "Program_Alarm";
             LibVersion := "1.0"
        }
        PA : Program_Alarm;
        Error : Bool;
        Status : Word;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44017_1"
    }
    NETWORK
        RUNG wire#powerrail
            #PA.Program_Alarm(
                SIG := "T7_Datos".Verdadero, 
                TIMESTAMP :=  , 
                SD_1 :=  , 
                SD_2 :=  , 
                SD_3 :=  , 
                SD_4 :=  , 
                SD_5 :=  , 
                SD_6 :=  , 
                SD_7 :=  , 
                SD_8 :=  , 
                SD_9 :=  , 
                SD_10 :=  , 
                Error => #Error, 
                Status => #Status
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_44017_2"
    }
    NETWORK
        RUNG wire#powerrail
            I_Contact( #Error )
            Eq{ SrcType := Word }(
                IN1 := #Status, 
                IN2 := 16#0
            )
            Coil( "T7_Resultado".L_Program_Alarm )
        END_RUNG

    END_NETWORK

END_FUNCTION_BLOCK
