{
    S7_Optimized := "TRUE";
    S7_Language := "LAD";
    S7_Author := "IA";
    S7_BlockNumber := "45017";
    S7_BlockTitle := "MLC_45017_0"
}
FUNCTION "T8_L_GET_DIAG" : Void
    VAR_TEMP 
        req : Bool;
        busy : Bool;
        ret : Int;
        hw : HW_ANY;
        mode : UInt;
        cnt : UInt;
        diag : Array[0..99] of Byte;
        det : Array[0..99] of Byte;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_45017_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            GET_DIAG(
                MODE := #mode, 
                LADDR := #hw, 
                RET_VAL => #ret, 
                CNT_DIAG => #cnt, 
                DIAG := #diag, 
                DETAIL := #det
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
