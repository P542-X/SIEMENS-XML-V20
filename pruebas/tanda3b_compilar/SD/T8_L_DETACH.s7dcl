FUNCTION "T8_L_DETACH" : Void
    VAR_TEMP 
        req : Bool;
        busy : Bool;
        ret : Int;
        ob : OB_ATT;
        ev : EVENT_ATT;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_45007_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            DETACH(
                OB_NR := #ob, 
                EVENT := #ev, 
                RET_VAL => #ret
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
