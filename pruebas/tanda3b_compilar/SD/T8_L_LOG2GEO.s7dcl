FUNCTION "T8_L_LOG2GEO" : Void
    VAR_TEMP 
        req : Bool;
        busy : Bool;
        ret : Int;
        hw : HW_ANY;
        {
             InstructionName := "GEOADDR";
             LibVersion := "1.0"
        }
        geo : GEOADDR;
    END_VAR

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_45019_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( #req )
            LOG2GEO(
                LADDR := #hw, 
                Ret_Val => #ret, 
                GEOADDR := #geo
            )
        END_RUNG

    END_NETWORK

END_FUNCTION
