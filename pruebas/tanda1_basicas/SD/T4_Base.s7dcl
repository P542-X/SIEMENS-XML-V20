FUNCTION "T4_Base" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41000_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( "T4_Datos".Tog )
            Not()
            Coil( "T4_Datos".Tog )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41000_2"
    }
    NETWORK
