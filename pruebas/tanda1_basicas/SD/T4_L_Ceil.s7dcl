FUNCTION "T4_L_Ceil" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41028_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            Ceil{
                SrcType := Real; 
                DestType := DInt; 
                DisableENO := TRUE
            }(
                IN := "T4_Datos".Ceil_In, 
                OUT => "T4_Datos".Ceil_Out
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41028_2"
    }
    NETWORK
        RUNG wire#powerrail
            Eq{ SrcType := DInt }(
                IN1 := "T4_Datos".Ceil_Out, 
                IN2 := 3
            )
            Coil( "T4_Resultado".L_Ceil )
        END_RUNG

    END_NETWORK

END_FUNCTION
