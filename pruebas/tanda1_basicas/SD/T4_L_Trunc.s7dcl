FUNCTION "T4_L_Trunc" : Void

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41030_1"
    }
    NETWORK
        RUNG wire#powerrail
            Contact( True )
            Trunc{
                SrcType := Real; 
                DestType := DInt; 
                DisableENO := TRUE
            }(
                IN := "T4_Datos".Trunc_In, 
                OUT => "T4_Datos".Trunc_Out
            )
        END_RUNG

    END_NETWORK

    {
      S7_Language := "LAD";
      S7_NetworkTitle := "MLC_41030_2"
    }
    NETWORK
        RUNG wire#powerrail
            Eq{ SrcType := DInt }(
                IN1 := "T4_Datos".Trunc_Out, 
                IN2 := 2
            )
            Coil( "T4_Resultado".L_Trunc )
        END_RUNG

    END_NETWORK

END_FUNCTION
