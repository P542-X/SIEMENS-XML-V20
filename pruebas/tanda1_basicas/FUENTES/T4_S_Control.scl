FUNCTION "T4_S_Control" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP
      i : Int;
      j : Int;
      r : Int;
      d : DInt;
      re : Real;
      w : Word;
      dw : DWord;
      lr : LReal;
   END_VAR

BEGIN
	// [SCL] REPEAT / UNTIL
	#i := 0;
	REPEAT
	    #i := #i + 1;
	UNTIL #i >= 3
	END_REPEAT;
	"T4_Resultado".S_REPEAT := #i = 3;

	// [SCL] EXIT y CONTINUE
	#i := 0;
	FOR #j := 1 TO 10 DO
	    IF #j = 2 THEN CONTINUE; END_IF;
	    IF #j = 5 THEN EXIT; END_IF;
	    #i := #i + 1;
	END_FOR;
	"T4_Resultado".S_EXIT_CONTINUE := #i = 3;

	// [SCL] GOTO y etiqueta
	#i := 0;
	GOTO SALTO;
	#i := 99;
SALTO:
	#i := #i + 1;
	"T4_Resultado".S_GOTO := #i = 1;

	// [SCL] RUNTIME
	#lr := RUNTIME("T4_Datos".Mem_Runtime);
	"T4_Resultado".S_RUNTIME := TRUE;

	// [SCL] GET_ERR_ID
	#w := GET_ERR_ID();
	"T4_Resultado".S_GET_ERR_ID := TRUE;
END_FUNCTION
